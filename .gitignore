__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/
wiki/site/
wiki/.watch.log

# Runtime APC snapshots are multi-gigabyte cache payloads, not durable evidence.
qualification/runs/**/*.safetensors

# Benchmark and qualification run artifacts: server logs, raw smoke fixtures,
# per-run admin tokens and multi-megabyte reports. A `git add -A` in a worktree
# that has just run the qualifier otherwise sweeps all of it into the commit
# (2026-09-21: 214 files, 2.3M lines, including a live admin token).
qualification/mtp-handoff-*.json
qualification/mtp-handoff-*.txt
qualification/mtp-handoff-*-artifacts/

# DS4.1 campaign sources are preserved as verified, deduplicated overlays in
# ds41-options-source-snapshots-20261027, rather than hundreds of full copies.
# Keep raw receipts and tensor evidence, but never publish transient API tokens
# or runtime prefix-cache payloads.
qualification/runs/ds41-options-*/source/
qualification/runs/ds41-options-*/rejected-source-attempt-*/
qualification/runs/ds41-options-*/admin-token
qualification/runs/ds41-options-*/apcv2/

# Per-run loopback admin tokens and signing keys written by campaign drivers.
qualification/runs/**/.runtime/
